# Copy to .env and fill in every value. Never commit .env.
# Generate secrets with e.g.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Hostname ---------------------------------------------------------------
# Public hostname (no scheme). Caddy gets a certificate for it; Keycloak lives at /auth.
APP_HOST=adventr.duckdns.org

# --- Postgres ---------------------------------------------------------------
# Superuser password (admin tasks and backups only).
POSTGRES_PASSWORD=change-me
# Owner of the "adventr" database, used by the app.
APP_DB_PASSWORD=change-me
# Owner of the "keycloak" database, used by Keycloak.
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak ---------------------------------------------------------------
# Admin console: https://<APP_HOST>/auth/admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of the confidential "adventr-app" client, shared by Keycloak and the app.
# Note: realm settings are imported only on the very first start. To change this later,
# update it in the admin console (Clients > adventr-app > Credentials) as well.
KEYCLOAK_CLIENT_SECRET=change-me
# Heap for Keycloak (it needs roughly 512 MB to 1 GB in total).
KEYCLOAK_JAVA_OPTS_HEAP=-Xms256m -Xmx768m

# --- SMTP (password-reset emails only) ------------------------------------------
# A free relay, e.g. Brevo free tier or a Gmail app password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=

# --- Google login (optional) ------------------------------------------------------
# The Google identity provider is imported disabled. After filling these in, enable it in
# the admin console (Identity providers > google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare Tunnel (Raspberry Pi variant only) -------------------------------
# Token of the tunnel from the Cloudflare Zero Trust dashboard; used by docker-compose.tunnel.yml.
# See docs/deploy-pi.md. Leave empty on the Oracle VM.
CLOUDFLARE_TUNNEL_TOKEN=

# --- App ------------------------------------------------------------------------
# Image tag for the app service (docker compose build tags it with this).
APP_VERSION=latest
APP_JAVA_OPTS=-Xmx384m -XX:+ExitOnOutOfMemoryError

# --- Backups ------------------------------------------------------------------------
# Nightly at BACKUP_TIME (HH:MM) in the time zone TZ; see docs/restore.md.
BACKUP_TIME=03:30
TZ=UTC
# rclone remote for off-host copies, e.g. "gdrive:adventr-backups" or "oci:adventr-backups".
# Create the remote first: docker compose run --rm backup rclone config
# Leave empty to keep backups on this host only (not recommended).
BACKUP_RCLONE_REMOTE=
